# ====================================================
# VARIABLES DE ENTORNO - EcoEmpack Backend
# COPIA este archivo como .env y completa los valores
# NUNCA subas el archivo .env a GitHub
# ====================================================

# Puerto del servidor
PORT=3000

# URI de conexion a MongoDB
# Opcion 1 - MongoDB local (debes tener MongoDB instalado)
MONGODB_URI=mongodb://localhost:27017/ecoempack

# Opcion 2 - MongoDB Atlas (nube, gratuito)
# MONGODB_URI=mongodb+srv://TU_USUARIO:TU_CONTRASENA@cluster0.xxxxx.mongodb.net/ecoempack

# Clave secreta para firmar JWT (CAMBIA ESTO por una cadena aleatoria larga)
JWT_SECRET=ecoempack_super_secreto_2024_cambia_esto_en_produccion

# Tiempo de expiracion del token JWT
JWT_EXPIRES_IN=7d

# Entorno de la aplicacion (development | production)
NODE_ENV=development

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5500
